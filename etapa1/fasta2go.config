# FASTA2GO - ajustes da extração (FASTA -> DuckDB), lidos por etapa1/main.py.
# Não há argumentos de linha de comando: o que muda entre execuções fica aqui.

[extraction]
; arquivo de entrada (aceita .gz) e banco de saída
fasta = data/uniprot_sprot.fasta
database = db/fasta2go.duckdb

; proteínas a gravar; vazio (ou ausente) grava o FASTA inteiro.
; o recorte pequeno é útil para testar a análise antes da extração completa
limit = 2000

; enriquecimento pela UniProt; false grava apenas proteínas e características
uniprot = true

; proteínas por lote. O lote inteiro fica em memória (FASTA, features, respostas
; da UniProt, CSVs e INSERT): ~80 KB por proteína, ~0,75 GB de RSS com 5.000;
; o lote de 100.000 exigiria ~7-8 GB.
batch_size = 5000

; accessions por requisição ao UniProt (limite do endpoint)
accessions_per_request = 200
