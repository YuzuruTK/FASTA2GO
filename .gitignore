# Input data (FASTA downloads are large and never versioned). The pinned GO
# sources in data/go_slim/ are small and must be versioned.
/data/*
!/data/go_slim/

# Generated database and staging files
/db/
/cache/
*.duckdb
*.duckdb.wal

# Python
.venv/
__pycache__/
*.py[cod]

# Notebooks
.ipynb_checkpoints/
