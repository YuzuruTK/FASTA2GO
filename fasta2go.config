# FASTA2GO - ajustes da extração (FASTA -> DuckDB).
# O main.py lê este arquivo na inicialização; a linha de comando continua podendo
# sobrescrever --fasta e --db.

[extraction]
; arquivo de entrada (aceita .gz) e banco de saída
fasta = data/uniprot_sprot.fasta
database = db/fasta2go.duckdb

; proteínas por lote. O lote inteiro fica em memória (FASTA, features, respostas
; da UniProt, CSVs e INSERT): ~80 KB por proteína, ~0,75 GB de RSS com 5.000;
; o lote de 100.000 exigiria ~7-8 GB.
batch_size = 5000

; accessions por requisição ao UniProt (limite do endpoint)
accessions_per_request = 200
